{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "build",
  "installCommand": "npm install",
  "redirects": [
    {
      "source": ":path*",
      "has": [
        {
          "type": "host",
          "value": "mapeoverde.org"
        }
      ],
      "destination": "https://www.mapeoverde.org/:path*",
      "statusCode": 301
    },
    {
      "source": ":path*",
      "has": [
        {
          "type": "header",
          "key": "x-forwarded-proto",
          "value": "http"
        }
      ],
      "destination": "https://www.mapeoverde.org/:path*",
      "statusCode": 301
    }
  ],
  "rewrites": [
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ]
}